// Gowin Physical Constraint File
// Project: BLDC Motor Controller iChip course 同济大学 June 2024
// Target: Sipeed Tang Primer 20K (GW2A-LV18PG256C8/I7 based)
//
// --- Legend for IO_PORT Attributes ---
// IO_TYPE = LVCMOS33 -> 3.3V Logic standard (noise margins, voltage levels).
// PULL_MODE = UP     -> Enables a weak internal pull-up resistor (prevents floating on inputs).
// PULL_MODE = NONE   -> Disables internal pull resistors (standard for outputs).
// DRIVE = 8          -> Defines output current capability as 8mA.
// BANK_VCCIO = 3.3 -> Specifies the I/O bank voltage is 3.3V.

// !! IMPORTANT !!
// The Verilog signal names in quotes (e.g., "clk") must exactly match the
// top-level port names in your main Verilog file.

// --- Clock Input ---
IO_LOC "clk" H11; // 27MHz clock input from on-board oscillator
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
/*
// --- Reset Input #Button S4 on the Dock --
IO_LOC "rst_n" C7;
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
*/
// --- Brake Input #Button S0 on the Dock ---
IO_LOC "BLDC_final_BRAKE" C7;
IO_PORT "BLDC_final_BRAKE" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// --- Motor Control Outputs (to H-Bridge) ---
// Note: PULL_MODE=NONE is standard for actively driven output pins.
IO_LOC "BLDC_final_hsu" J14; // HS_U
IO_PORT "BLDC_final_hsu" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "BLDC_final_lsu" M15; // LS_U
IO_PORT "BLDC_final_lsu" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "BLDC_final_hsv" J16; // HS_V
IO_PORT "BLDC_final_hsv" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "BLDC_final_lsv" T12; // LS_V
IO_PORT "BLDC_final_lsv" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "BLDC_final_hsw" M14; // HS_W
IO_PORT "BLDC_final_hsw" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "BLDC_final_lsw" R11; // LS_W
IO_PORT "BLDC_final_lsw" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// --- Hall Sensor Inputs ---
// Note: DRIVE attribute is not applicable to inputs.
