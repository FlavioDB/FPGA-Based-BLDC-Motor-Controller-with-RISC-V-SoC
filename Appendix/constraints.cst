// --- LED Indicators (DRIVE=4mA is sufficient) ---
// Blink LED connected to Orange_LEDO (indicates CPU is running)
/*IO_LOC "heartbeat_led_out" C13;
IO_PORT "heartbeat_led_out" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
*/

// Brake Status LED connected to Orange_LED1
IO_LOC "brake_led_out" A13;
IO_PORT "brake_led_out" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;


