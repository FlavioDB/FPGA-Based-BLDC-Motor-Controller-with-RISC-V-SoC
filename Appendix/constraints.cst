/*
// --- JTAG Interface (Essential for programming and debugging) ---
// JTAG (Joint Test Action Group -> mechanism used to program the FPGA's configuration memory and to debug the hardware in real-time)
//  They are for the fundamental infrastructure that allows your computer to program and communicate with the FPGA chip, leave them as they are
IO_LOC "tdi" A7;
IO_PORT "tdi" IO_TYPE=LVCMOS33 PULL_MODE=UP; // Test Data In
IO_LOC "tdo" C6;
IO_PORT "tdo" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8; // Test Data Out
IO_LOC "tck" A6;
IO_PORT "tck" IO_TYPE=LVCMOS33 PULL_MODE=UP; // Test Clock
IO_LOC "tms" B8;
IO_PORT "tms" IO_TYPE=LVCMOS33 PULL_MODE=UP; // Test Mode Select
*/
//Useful for debug printing, to be kept intact
IO_LOC "gpio_in[16]" T13;
IO_LOC "gpio_out[17]" M11;

IO_PORT "gpio_in[16]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "gpio_out[17]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
